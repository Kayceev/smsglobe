# Deemax environment template. Copy to .env and fill in. Never commit .env.
# Production values live in the Vercel project settings.

# --- DATABASE ---
MONGODB_URI=

# --- AUTH ---
JWT_SECRET=
GOOGLE_CLIENT_ID=

# --- SITE ---
# Public address used in payment redirects and email links (default https://www.deemaxhub.com)
APP_BASE_URL=

# --- EMAIL (SendByte SMTP via Nodemailer) ---
# SendByte (app.sendbyte.africa): SMTP_USER is always "apikey", SMTP_PASS is an API key
# (sk_live_ sends for real from deemaxhub.com, sk_test_ only to the sandbox).
# Leave SMTP_HOST empty to fall back to the old Gmail account below.
SMTP_HOST=smtp.sendbyte.africa
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
# From address on every email; must be on the domain verified in SendByte
EMAIL_FROM=noreply@deemaxhub.com
# Old Gmail sender (used only when SMTP_HOST is empty)
EMAIL_USER=
EMAIL_PASS=
ADMIN_EMAIL=

# --- PAYMENTS (Flutterwave) ---
FLW_SECRET_KEY=
# Same "secret hash" as Flutterwave Dashboard > Settings > Webhooks (URL: /api/flutterwave-webhook)
FLW_WEBHOOK_HASH=

# --- SMS PROVIDER (SMSBower) ---
SMSBOWER_API_KEY=
SMSBOWER_BASE_URL=https://smsbower.page/stubs/handler_api.php
# 16+ random characters. Without it the SMSBower webhook refuses every call (codes still arrive
# through polling). Callers send it as ?secret=<value> on the URL or an x-webhook-secret header.
SMSBOWER_WEBHOOK_SECRET=

# --- ACCOUNTS & VPN PROVIDER (Sameeha's Socialhub) ---
# API key from https://sameehasocialhub.com/api-docs/ (sent as a Bearer token)
SAMEEHA_API_KEY=
SAMEEHA_BASE_URL=https://sameehasocialhub.com/api/v1

# --- UPLOADS (Cloudinary, signed uploads via /api/upload-receipt) ---
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# --- SCHEDULED JOBS ---
# Vercel Cron sends this as a Bearer token to /api/expire-sms-orders
CRON_SECRET=

# --- LOCAL DEVELOPMENT ONLY (never set these in Vercel) ---
DEMO_LOGIN_ENABLED=
# Also allow demo login from devices on the home Wi-Fi (e.g. http://192.168.x.x:3000 on a phone)
DEMO_LOGIN_ALLOW_LAN=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
# Fake SMS vendor so the SMS page works with no SMSBower key. Gated off in
# production (see isSmsDemoMode in api.js): demo numbers start with DEMO-,
# cost real wallet balance, and receive a fake code ~25s after purchase.
SMS_DEMO_MODE=
# Fake Sameeha catalog so the Accounts & VPN page works with no API key. Gated off
# in production (see isAccountsDemoMode in api.js). Purchases cost real wallet balance.
ACCOUNTS_DEMO_MODE=
